# Server-only. Never prefix credentials with VITE_.
PORT=3001
# Demo mode requires no credentials and never calls external services.
DATA_MODE=demo
# Live mode requires all four values below. Use only the dedicated Growth Agent project.
# SUPABASE_SECRET_KEY accepts the current sb_secret_ key; never use a browser VITE_ variable.
HUNTER_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# UUID of the sole permitted Supabase Auth user; disable public signups.
OWNER_USER_ID=
