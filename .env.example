# Server-only. Never prefix credentials with VITE_.
PORT=3001
# Demo mode requires no credentials and never calls external services.
DATA_MODE=demo
# Live mode requires all four values below. Use only the dedicated Growth Agent project.
# SUPABASE_SECRET_KEY accepts the current sb_secret_ key; never use a browser VITE_ variable.
HUNTER_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# UUID of the sole permitted Supabase Auth user; disable public signups.
OWNER_USER_ID=

# Autonomous growth: safe defaults. Existing DATA_MODE controls storage, not sending.
AUTOMATION_WORKER_ENABLED=false
ENABLE_PAID_HUNTER=false
ENABLE_REAL_SENDING=false
ENABLE_TEST_SENDING=false

# Server-only Google OAuth connection for churnautopsy@gmail.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
TEST_RECIPIENT=

# Public HTTPS origin serving ONLY /u/*; dashboard stays private.
UNSUBSCRIBE_BASE_URL=
UNSUBSCRIBE_SIGNING_SECRET=

# Optional local Ollama model (no paid AI provider). Empty uses evidence rules only.
LOCAL_QUALIFICATION_MODEL=
# Container only; leave loopback for local development.
HOST=127.0.0.1
